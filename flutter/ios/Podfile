source 'https://cdn.cocoapods.org/'

# Uncomment this line to define a global platform for your project
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# 使用本地 TensorFlowLiteSwift 替代远程 pod（避免克隆整个 TensorFlow 仓库）
# 注意：TensorFlowLiteC framework 已包含 Select TF Ops 符号，
# 在 Dart 层使用 TfLiteInterpreterCreateWithSelectedOps 即可支持
pod 'TensorFlowLiteSwift', :path => 'LocalPods/TensorFlowLiteSwift'

# 使用本地 nanopb 替代远程 pod（避免 GitHub clone 超时）
pod 'nanopb', :path => 'LocalPods/nanopb-0.3.9.10'

# 强制 MLKitVision 版本，解决 google_mlkit_commons 与 MLKitFaceDetection 的版本冲突
pod 'MLKitVision', '~> 8.0'

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # 强制所有 Pod 最低部署目标为 15.5
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.5
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
      end
      # permission_handler 需要显式启用各权限宏，否则 iOS 上对应权限不会生效
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_CAMERA=1'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_PHOTOS=1'
    end
  end

  # 统一 EXCLUDED_ARCHS，解决 pod 间 user_target_xcconfig 冲突
  # 直接修改生成的 xcconfig 文件，移除冲突的 EXCLUDED_ARCHS 条目
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.xcconfigs.each do |config_name, config_file|
      xcconfig_path = aggregate_target.xcconfig_path(config_name)
      xcconfig = File.read(xcconfig_path)
      # 统一 EXCLUDED_ARCHS 为 i386（与 Flutter Generated.xcconfig 一致）
      xcconfig = xcconfig.gsub(/EXCLUDED_ARCHS\[sdk=iphonesimulator\*\]\s*=.*/) { '' }
      File.write(xcconfig_path, xcconfig)
    end
  end
end
